# Kartfliser. Standard er CARTO Voyager (OpenStreetMap-data). Bytt til en annen leverandør her.
# {s}, {z}, {x}, {y} og {r} er Leaflet-plassholdere.
# Med CARTO-nøkkel: https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=DIN_NØKKEL
# På GitHub Pages settes denne fra repovariabelen MAP_TILE_URL (se .github/workflows/deploy.yml).
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-bidragsytere © <a href="https://carto.com/attributions">CARTO</a>
VITE_MAP_TILE_SUBDOMAINS=abcd
VITE_MAP_TILE_MAX_ZOOM=19

# Det felles arkivet (Supabase). Uten disse kjører appen bare lokalt på telefonen.
# På GitHub Pages settes de fra repovariablene SUPABASE_URL og SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
